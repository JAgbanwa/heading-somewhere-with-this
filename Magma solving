Z := Integers();

N := 172757;

sols := {};

for a in Divisors(N) do
    b := N div a;

    if IsEven(a + b) and IsEven(b - a) then
        x := Abs((b - a) div 2);
        y := Abs((a + b) div 2);

        Include(~sols, <x,y>);
    end if;
end for;

print "Solutions in compact +/- form:";

for P in Sort(Setseq(sols)) do
    printf "(x,y) = (+/-%o, +/-%o)\n", P[1], P[2];
end for;
