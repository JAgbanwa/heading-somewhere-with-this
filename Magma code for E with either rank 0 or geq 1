for m in [1..50] do
    
    // Define elliptic curve in monic cubic form
    E := EllipticCurve([0, m, 0, m^2/3, (m^3-19)/36]);

    // Minimal model improves stability
    Emin, phi := MinimalModel(E);

    // Rank computation
    r := Rank(Emin);

    if r ge 1 then
        printf "m = %o has rank >= 1 (rank = %o)\n", m, r;
    end if;

end for;


