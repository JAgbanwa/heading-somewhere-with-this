/-! ## Section 7. Structural observations and obstructions -/
/-
Proposition 7.1: the moduli grow without bound.  For any bound `B` there is a congruence
pair `(n, M)` with `M > B` and `M ∣ 36 n^3 - 19`.  (Uses Dirichlet's theorem to find a large
prime `p ≡ 2 (mod 3)`, which always admits a cube root.)
-/
theorem moduli_unbounded (B : ℤ) : ∃ (M : ℤ) (n : ℤ), B < M ∧ M ∣ 36 * n ^ 3 - 19 := by
  -- By Nat.infinite_setOf_prime_and_eq_mod, the set {p | p.Prime ∧ (p : ZMod 3) = 2} is infinite.
  have h_inf : Set.Infinite {p : ℕ | Nat.Prime p ∧ p % 3 = 2} := by
    convert Nat.infinite_setOf_prime_and_eq_mod ( show IsUnit ( 2 : ZMod 3 ) by decide ) using 1;
    norm_num [ Set.ext_iff, ZMod.natCast_eq_natCast_iff' ];
    intro x hx; erw [ ZMod.natCast_eq_natCast_iff ] ; norm_num [ Nat.ModEq ] ;
  obtain ⟨ p, hp₁, hp₂ ⟩ := h_inf.exists_gt ( Int.toNat B + 5 );
  -- By exists_unique_of_two_mod_three, there exists a unique $n_0 \in \mathbb{Z}/p\mathbb{Z}$ such that $36 n_0^3 = 19$.
  obtain ⟨ n₀, hn₀ ⟩ : ∃ n₀ : ZMod p, 36 * n₀ ^ 3 = 19 := by
    haveI := Fact.mk hp₁.1;
    exact exists_unique_of_two_mod_three ( by linarith [ Int.self_le_toNat B ] ) hp₁.2 |> ExistsUnique.exists;
  refine' ⟨ p, n₀.val, _, _ ⟩;
  · linarith [ Int.self_le_toNat B ];
  · haveI := Fact.mk hp₁.1; simp_all +decide [ ← ZMod.intCast_zmod_eq_zero_iff_dvd ] ;
/-- Proposition 7.2: hard obstruction at `2`, `3` and `19^2`.  None of `2`, `3`, `361`
divides `36 n^3 - 19` for any `n`. -/
theorem hard_obstruction (n : ℤ) :
    ¬ (2 ∣ 36 * n ^ 3 - 19) ∧ ¬ (3 ∣ 36 * n ^ 3 - 19) ∧ ¬ (361 ∣ 36 * n ^ 3 - 19) :=
  ⟨not_two_dvd n, not_three_dvd n, not_threesixtyone_dvd n⟩
end Congruences36n3
