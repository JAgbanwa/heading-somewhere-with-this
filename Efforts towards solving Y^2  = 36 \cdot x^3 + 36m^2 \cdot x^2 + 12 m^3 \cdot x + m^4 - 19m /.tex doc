%------------------------------------------------------------------
\section{Structural Observations and Obstructions}
%------------------------------------------------------------------

\begin{proposition}[The moduli grow without bound]
For any $B>0$ there exists a congruence pair $(n_0, M)$ with $M>B$ and
$M\mid 36n_0^3-19$.
\end{proposition}
\begin{proof}
By Dirichlet's theorem on primes in arithmetic progressions, there are
infinitely many primes $p\equiv 2\pmod{3}$.
Each such prime $p\notin\{2,3\}$ admits a unique $r_p$ with
$36 r_p^3\equiv 19\pmod{p}$.
Adjoining further such primes to any existing set $\mathcal{P}$ multiplies
the modulus by $p$ while preserving the CRT compatibility, yielding
arbitrarily large moduli.
\end{proof}

\begin{proposition}[Hard obstruction at $p=2,3$ and $19^2$]
The prime $2$, the prime $3$, and the prime power $19^2$ can never
divide $36n^3-19$. In particular the $2$-part, $3$-part, and any
$19$-part beyond $v_{19}=1$ of $m$ are permanently forbidden.
\end{proposition}

\begin{remark}[Connection to the Diophantine surface]
The variable $m$ (or $x$ in the SageMath search code) here is the
divisor parameter in the equation
\[
  y = -x + \sqrt{(x+6n)^2 + \tfrac{36n^3-19}{x}},
\]
which is equivalent to the factorisation identity
\[
  x(y-6n)(y+2x+6n) = 36n^3-19.
\]
This is distinct from the parameter $m$ in the elliptic-surface equation
$y^2 = (36n^3-19-12mn)^2-(2m)^3$, although the two problems are linked
through the same polynomial $36n^3-19$.
\end{remark}

%------------------------------------------------------------------
\section{Extension Algorithm}
%------------------------------------------------------------------

The following procedure generates congruence pairs of any desired size.

\begin{enumerate}
  \item Start with $\mathcal{P}=\emptyset$, $M=1$, $n_0=0$.
  \item Pick any admissible prime $p\notin\mathcal{P}$
        (i.e.\ $p\notin\{2,3\}$, $p\neq 19^2$).
  \item Compute $c_p = 19\cdot 36^{-1}\bmod p$.
        \begin{itemize}
          \item If $p\equiv 2\pmod{3}$: compute the unique root
                $r_p = c_p^{(2p-1)/3}\bmod p$.
          \item If $p\equiv 1\pmod{3}$: check $c_p^{(p-1)/3}\equiv 1\pmod{p}$;
                if so, choose any of the three cube roots as $r_p$.
                If the condition fails, discard $p$ and return to step 2.
        \end{itemize}
  \item Set $n_0 \leftarrow \mathrm{CRT}(n_0, r_p; M, p)$ and
        $M \leftarrow M\cdot p$.
  \item Verify $M\mid 36n_0^3-19$, then repeat from step 2.
\end{enumerate}

Each iteration multiplies $M$ by $p$, so the modulus grows at least as
fast as the product of successive primes $\equiv 2\pmod{3}$.

