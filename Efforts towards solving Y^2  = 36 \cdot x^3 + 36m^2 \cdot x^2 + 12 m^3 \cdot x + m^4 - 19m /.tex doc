%------------------------------------------------------------------
\section{Setup and Necessary Conditions}
%------------------------------------------------------------------

We seek all integers $m \geq 1$ and $n \in \Z$ such that
\[
  m \mid 36n^3 - 19.
\]
By the Chinese Remainder Theorem it suffices to work prime-by-prime:
$m \mid 36n^3-19$ if and only if $p^{v_p(m)} \mid 36n^3-19$ for every
prime $p \mid m$, where $v_p$ denotes the $p$-adic valuation.

\begin{proposition}[Forbidden primes]\label{prop:forbidden}
The following primes can never divide $36n^3-19$:
\begin{enumerate}
  \item $p = 2$: $36n^3 - 19 \equiv 1 \pmod{2}$ for all $n$.
  \item $p = 3$: $36n^3 - 19 \equiv 2 \pmod{3}$ for all $n$ (in fact
        $36n^3-19\equiv 8\pmod{9}$).
\end{enumerate}
Hence any $m$ with $2\mid m$ or $3\mid m$ is inadmissible.
\end{proposition}

\begin{proposition}[$p=19$ is special]\label{prop:19}
For $p=19$: $19\mid 36n^3-19$ if and only if $19\mid n$.
Moreover, $19^2 \nmid 36n^3-19$ for any $n$.
Concretely, if $n = 19k$ then
\[
  36(19k)^3 - 19 = 19\bigl(36\cdot 19^2 k^3 - 1\bigr),
\]
and $36\cdot 19^2 k^3 \equiv 0 \not\equiv 1 \pmod{19}$, so the
$19$-adic valuation of $36n^3-19$ is exactly $1$ whenever $19\mid n$.
The prime $19^2$ is therefore permanently forbidden.
\end{proposition}

%------------------------------------------------------------------
\section{The Cubic Residue Criterion}
%------------------------------------------------------------------

For an odd prime $p \notin \{3,19\}$ with $p \nmid m$, we need
$36n^3 \equiv 19\pmod{p}$, i.e.\
\[
  n^3 \equiv c_p \pmod{p}, \qquad c_p := 19\cdot 36^{-1}\bmod p.
\]
The number of solutions depends on $p \bmod 3$.

\begin{theorem}[Cube roots mod $p$]\label{thm:cuberoots}
Let $p \geq 5$ be prime, $p \neq 19$, and set $c_p = 19\cdot 36^{-1}\bmod p$.
\begin{enumerate}
  \item If $p \equiv 2\pmod{3}$: the map $x\mapsto x^3$ is a bijection
        on $\Fp^*$, so there is a \emph{unique} solution
        $n \equiv c_p^{(2p-1)/3}\pmod{p}$.
  \item If $p \equiv 1\pmod{3}$: solutions exist if and only if
        $c_p^{(p-1)/3}\equiv 1\pmod{p}$ (the cubic-residue condition).
        When this holds there are exactly $3$ solutions.
\end{enumerate}
\end{theorem}

\begin{remark}
For Hensel lifting to prime powers $p^k$ with $k\geq 2$: since the
derivative $\frac{d}{dn}(36n^3) = 108n^2 \not\equiv 0\pmod{p}$ for $p\nmid n$
and $p\nmid 36$, each simple root mod $p$ lifts uniquely to a root mod $p^k$
by Hensel's lemma. The exception is $p=19$ (covered separately), where
no lifting to $19^2$ exists.
\end{remark}

%------------------------------------------------------------------
\section{Necessary and Sufficient Conditions}
%------------------------------------------------------------------

\begin{theorem}[Complete characterisation]\label{thm:main}
$m \mid 36n^3-19$ if and only if:
\begin{enumerate}
  \item $m$ is odd;
  \item $3\nmid m$;
  \item $19^2\nmid m$;
  \item for every prime $p\mid m$ with $p\equiv 2\pmod{3}$, $p\neq 19$:
        $n \equiv c_p^{(2p-1)/3}\pmod{p}$;
  \item for every prime $p\mid m$ with $p\equiv 1\pmod{3}$:
        $c_p^{(p-1)/3}\equiv 1\pmod{p}$ and $n$ is one of the three
        cube roots of $c_p$ modulo $p$;
  \item if $19\mid m$: $n\equiv 0\pmod{19}$.
\end{enumerate}
The residue class of $n$ modulo $m$ (or $m/19$ if $19\|m$) is then
determined by the Chinese Remainder Theorem from conditions
\emph{(4)--(6)}.
\end{theorem}

%------------------------------------------------------------------
\section{CRT Construction of Congruence Pairs}
%------------------------------------------------------------------

Fix a finite set $\mathcal{P}$ of admissible primes satisfying the
conditions of Theorem~\ref{thm:main}.
For each $p\in\mathcal{P}$ choose one residue $r_p\in\{0,\dots,p-1\}$
with $36 r_p^3 \equiv 19\pmod{p}$.
By CRT there is a unique $n_0\bmod M$ with $M=\prod_{p\in\mathcal{P}}p$
such that $n_0\equiv r_p\pmod{p}$ for all $p$, and $M\mid 36n_0^3-19$.

\begin{remark}[Branching at $p\equiv 1\pmod{3}$]
Each prime $p\equiv 1\pmod{3}$ where $c_p$ is a cubic residue introduces
three admissible residues and hence \emph{triples} the number of CRT
branches. All branches are equally valid; we typically fix the
lexicographically smallest root for concreteness.
\end{remark}

