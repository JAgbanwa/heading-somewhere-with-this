\begin{remark}[Summary statistics]
\leavevmode
\begin{enumerate}
\item \textbf{102 signed solutions} across 51 triples, found over a
  systematic search covering $1\le|m|\le10^{10}$.
\item \textbf{New $|n|$ record:} $37\,917$, found at
  $|m|\approx3.8\times10^{9}$ on an Apple M1 Pro in under 2 hours.
\item \textbf{$n$-range:} grew from $[-1641,\,5118]$ to
  $[-37917,\,27949]$.
\item \textbf{Large-$|n|$ bias:} among distinct fibers discovered at
  $|m|>10^{8}$, nine of thirteen have $|n|>9000$.
\item \textbf{Solution spacing:} gaps between consecutive solutions (in
  $|m|$) range from $\sim10^{6}$ to $\sim8\times10^{8}$, consistent
  with Poisson spacing at density $\sim1$ per $\sim3\times10^{8}$ in
  the second decade $[10^{9},10^{10}]$.
\end{enumerate}
\end{remark}

\section{Software and reproducibility}

\begin{itemize}
\item \texttt{divisor\_sweep.c}: exhaustive sweep. Compile:
  \texttt{gcc -O3 -funroll-loops -o divisor\_sweep divisor\_sweep.c -lm}.
  Usage: \texttt{./divisor\_sweep lo hi outfile}.
\item \texttt{run\_sweep.sh}: parallel driver.
  Usage: \texttt{./run\_sweep.sh lo hi ncores}.
\item \texttt{verify\_solutions.py}: exact verification of all $51$ rows
  and any new hits; automatically applies the translate
  map~\eqref{eq:map}.
\end{itemize}

\noindent\textbf{Extending the search.}
To $M=10^{11}$: $\sim500$ core-hours (trivially parallel).
Negative-$m$ classification per fiber: Magma \texttt{IntegralPoints(E\_n)}
looped over $|n|\le10^{5}$ ($\sim10^{5}$ curves, feasible on a cluster or
via Charity Engine).

