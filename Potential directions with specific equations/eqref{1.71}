\section{Method and completeness}

\subsection{The divisor-pair reduction}

Write $A=36n^{3}-19-12mn$, so~\eqref{eq:main} reads $A^{2}-y^{2}=8m^{3}$,
equivalently
\begin{equation}\label{eq:pair}
d'e'=2m^{3},\qquad d'=\tfrac{A-y}{2},\quad e'=\tfrac{A+y}{2}.
\end{equation}
Every signed divisor pair $(d',e')$ of $2m^{3}$ determines $A=d'+e'$, and a
solution requires $n\in\mathbb{Z}$ satisfying
\begin{equation}\label{eq:cubic}
36n^{3}-12mn-(A+19)=0,
\end{equation}
which forces $A\equiv5\pmod{12}$. The search algorithm enumerates, for each
$m$ in a range, all divisor pairs of $2m^{3}$ (segmented-sieve factorization
with \texttt{uint64} remainder array; pairs generated multiplicatively in
tandem; residues modulo $5,7,9,11,12,13$ tracked for pre-filtering; divisor
count cap of $2\times10^{6}$ to skip pathological smooth numbers; integer
roots of~\eqref{eq:cubic} located by Cardano's formulae with exact $128$-bit
confirmation).

\begin{theorem}\label{thm:complete}
Table~\ref{tab:main} lists every nontrivial solution of~\eqref{eq:main} with
$1\le|m|\le10^{11}$ \textup{(}pending completion of the current run covering
$[10^{10},10^{11}]$\textup{)}, all $n$, both signs. Three rows lie outside
the $10^{10}$ window --- $(798,-5\,378\,466\,956\,142)$,
$(14709,-2\,616\,641\,560)$, and $(-29317,-335\,124\,555\,576)$ --- and each
is the torsion translate of an in-window row.
\end{theorem}

\begin{remark}[The $\star\star$ solutions]
The six solutions marked $\star\star$ were found by running
\texttt{divisor\_sweep} on an Apple M1 Pro MacBook Pro. Two
($n=-37917$, $n=-6565$) came from a $15$-hour run covering
$[2.814\times10^{9},10^{10}]$. Six more
($n=-53316$, $n=-34655$, $n=57534$, $n=64808$, $n=138693$, $n=167163$)
came from the ongoing run covering $[10^{10},10^{11}]$. The solution
$n=167163$ sets a new record for $|n|$, surpassing $37917$ by a factor
of $4.4$ and breaking the $10^{5}$ barrier for the first time. All six
large solutions satisfy $|n|>10^{4}$, consistent with the systematic
large-$|n|$ bias observed throughout the search.
\end{remark}

\subsection{Positive-$m$ classification}

\begin{corollary}\label{cor:posm}
If $m>0$ then $m\le24n^{2}$ for $|n|\ge2$. Since
$24\cdot64{,}549^{2}<10^{11}$, for every $|n|\le64{,}549$ the positive-$m$
entries of Table~\ref{tab:main} are \emph{provably complete}.
\end{corollary}

\section{The torsion-translate correspondence}\label{sec:translate}

For fixed $n$, $c=36n^{3}-19$, the equation is
$E_{n}\colon Y^{2}=X^{3}+36n^{2}X^{2}+12ncX+c^{2}$ with $X=-2m$, $Y=y$.
The section $T=(0,c)$ has exact order $3$. Translation by $T$ gives
\begin{equation}\label{eq:map}
m'=-\frac{1}{2}\!\left[\!\left(\frac{\varepsilon y-c}{2m}\right)^{\!2}
-36n^{2}+2m\right],\quad\varepsilon\in\{\pm1\},
\end{equation}
