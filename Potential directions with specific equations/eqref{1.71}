\section{Method and completeness}

\subsection{The divisor-pair reduction}

Write $A=36n^{3}-19-12mn$, so~\eqref{eq:main} reads $A^{2}-y^{2}=8m^{3}$,
equivalently
\begin{equation}\label{eq:pair}
d'e'=2m^{3},\qquad d'=\tfrac{A-y}{2},\quad e'=\tfrac{A+y}{2}.
\end{equation}
Every signed divisor pair $(d',e')$ of $2m^{3}$ determines $A=d'+e'$, and a
solution requires $n\in\mathbb{Z}$ satisfying
\begin{equation}\label{eq:cubic}
36n^{3}-12mn-(A+19)=0,
\end{equation}
which forces $A\equiv5\pmod{12}$. The search algorithm enumerates, for each
$m$ in a range, all divisor pairs of $2m^{3}$ (segmented-sieve factorization;
pairs generated multiplicatively in tandem; residues modulo $5,7,9,11,12,13$
tracked for pre-filtering; integer roots of~\eqref{eq:cubic} located by
Cardano's formulae with exact $128$-bit confirmation) and is exhaustive in
$n$ for each such $m$.

\begin{theorem}\label{thm:complete}
Table~\ref{tab:main} lists every nontrivial solution of~\eqref{eq:main} with
$1\le|m|\le10^{10}$, all $n$, both signs. Exactly three rows lie outside
this window --- $(798,-5\,378\,466\,956\,142)$,
$(14709,-2\,616\,641\,560)$, and $(-29317,-335\,124\,555\,576)$ --- and each
is the torsion translate \textup{(}Section~\ref{sec:translate}\textup{)} of
an in-window row on the same fiber.
\end{theorem}

\begin{remark}
The final solution in the table, $(-37917,-3\,798\,121\,117)$, was discovered
by running \texttt{divisor\_sweep} on an Apple M1 Pro MacBook Pro covering
$|m|\in[2.814\times10^{9},10^{10}]$ on $8$ cores. It sets a new record for
$|n|$, surpassing the previous record of $29\,317$.
\end{remark}

\subsection{Stratified completeness}

\begin{proposition}
The only solutions with $1\le|m|\le10^{10}$ and balance parameter
$d_{\min}=\min(|d'|,|e'|)\le64$ are $(1,-3,55)$ and
$(798,-5586,18\,347\,596\,867)$.
\end{proposition}

\subsection{Positive-$m$ classification}

\begin{corollary}\label{cor:posm}
For every $|n|\le9278$, the positive-$m$ entries of
Table~\ref{tab:main} are provably complete, consisting exactly of the rows
\begin{equation*}
n\in\{-4741,-921,-367,-54,75,114,309,790,909,1759,14709,16531,17309,27949\},
\quad m>0.
\end{equation*}
\end{corollary}

\section{The torsion-translate correspondence}\label{sec:translate}

Substituting $X=-2m$, $Y=y$, $c=36n^{3}-19$ turns~\eqref{eq:main} into
\begin{equation}\label{eq:en}
E_{n}\colon\quad Y^{2}=X^{3}+36n^{2}X^{2}+12ncX+c^{2}.
\end{equation}
The tautological section $T=(0,c)$ has exact order $3$ on every fiber.
Translation by $T$ gives the explicit map
\begin{equation}\label{eq:map}
m'=-\frac{1}{2}\!\left[\!\left(\frac{\varepsilon y-c}{2m}\right)^{\!2}
-36n^{2}+2m\right],\quad\varepsilon\in\{\pm1\},
\end{equation}
