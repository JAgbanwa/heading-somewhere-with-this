\section{Method and completeness}

\subsection{The divisor-pair reduction}

Write $A=36n^{3}-19-12mn$, so~\eqref{eq:main} reads $A^{2}-y^{2}=8m^{3}$,
equivalently
\begin{equation}\label{eq:pair}
d'e'=2m^{3},\qquad d'=\tfrac{A-y}{2},\quad e'=\tfrac{A+y}{2}.
\end{equation}
Every signed divisor pair $(d',e')$ of $2m^{3}$ determines $A=d'+e'$, and a
solution requires $n\in\mathbb{Z}$ satisfying
\begin{equation}\label{eq:cubic}
36n^{3}-12mn-(A+19)=0,
\end{equation}
which forces $A\equiv5\pmod{12}$. The search algorithm enumerates, for each
$m$ in a range, all divisor pairs of $2m^{3}$ (segmented-sieve factorization;
pairs generated multiplicatively in tandem; residues modulo $5,7,9,11,12,13$
tracked for pre-filtering; integer roots of~\eqref{eq:cubic} located by
Cardano's formulae with exact $128$-bit confirmation) and is exhaustive in
$n$ for each such $m$.

\begin{theorem}\label{thm:complete}
Table~\ref{tab:main} lists every nontrivial solution of~\eqref{eq:main} with
$1\le|m|\le2.067\times10^{9}$, all $n$, both signs. Exactly three rows lie
outside this window --- $(798,-5\,378\,466\,956\,142)$,
$(14709,-2\,616\,641\,560)$, and $(-29317,-335\,124\,555\,576)$ --- and each
is the torsion translate \textup{(}Section~\ref{sec:translate}\textup{)} of
an in-window row on the same fiber.
\end{theorem}

\subsection{Stratified completeness to $10^{10}$}

Define the \emph{balance parameter} $d_{\min}=\min(|d'|,|e'|)$ of a
solution. For fixed $d$, the condition $d\mid2m^{3}$ confines $m$ to the
progression $q(d)\mathbb{Z}$ where
$q(d)=\prod_{p^{a}\parallel d}p^{\lceil(a-[p=2])/3\rceil}$; then
$e=2m^{3}/d=(2q(d)^{3}/d)\,k^{3}$ requires no division, so the stratum
$\{d_{\min}\le D,\,|m|\le M\}$ is enumerable at cost
$M\sum_{d\le D}1/q(d)$ candidates (logarithmic growth in $D$).

\begin{proposition}[Stratified completeness]
The only solutions with $1\le|m|\le10^{10}$ and $d_{\min}\le64$ are
$(1,-3,55)$ and $(798,-5586,18\,347\,596\,867)$.
\end{proposition}

\subsection{Positive-$m$ classification}

\begin{corollary}\label{cor:posm}
If $m>0$ then $m\le24n^{2}$ for $|n|\ge2$ \textup{(}and $m\le25$ for
$|n|=1$\textup{)}. Since $24\cdot9278^{2}<2.067\times10^{9}$, for every
$|n|\le9278$ the positive-$m$ entries of Table~\ref{tab:main} are
\emph{provably complete} and consist exactly of the rows
\begin{equation*}
n\in\{-4741,-921,-367,-54,75,114,309,790,909,1759,14709,16531,17309,27949\},
\quad m>0.
\end{equation*}
In particular, fibers $E_{n}$ absent from this list
\textup{(}e.g.\ $n=1,15,19,46,\ldots$\textup{)} have \emph{no} positive-$m$
solutions for $|n|\le9278$.
\end{corollary}

\section{The torsion-translate correspondence}\label{sec:translate}

Substituting $X=-2m$, $Y=y$, $c=36n^{3}-19$ turns~\eqref{eq:main} into the
elliptic fibration
\begin{equation}\label{eq:en}
E_{n}\colon\quad Y^{2}=X^{3}+36n^{2}X^{2}+12ncX+c^{2}.
\end{equation}
The tautological section $T=(0,c)$ corresponds to the trivial family $m=0$.

\begin{proposition}
$T$ has exact order $3$ on every fiber $E_{n}$; in particular
$\mathbb{Z}/3\mathbb{Z}\subseteq E_{n}(\mathbb{Q})_{\mathrm{tors}}$ for all
$n$.
\end{proposition}

Translation by $T$ carries solutions to solutions via the explicit map
\begin{equation}\label{eq:map}
m'=-\frac{1}{2}\!\left[\!\left(\frac{\varepsilon y-c}{2m}\right)^{\!2}
-36n^{2}+2m\right],\quad\varepsilon\in\{\pm1\},
\end{equation}
whenever the right-hand side is a nonzero integer. This pairs six fibers:

\begin{center}
\begin{tabular}{ll}
\toprule
Fiber $n$ & Translate pair $(m\leftrightarrow m')$\\
\midrule
$1$       & $-3\leftrightarrow-51$\\
$-54$     & $4\,749\leftrightarrow-10\,743$\\
$798$     & $-5\,586\leftrightarrow-5\,378\,466\,956\,142$\\
$909$     & $1\,826\,300\leftrightarrow-11\,607\,484$\\
$14709$   & $473\,559\,320\leftrightarrow-2\,616\,641\,560$\\
$-29317$  & $-1\,373\,577\,672\leftrightarrow-335\,124\,555\,576$\\
\bottomrule
\end{tabular}
\end{center}

\noindent
The two largest known solutions are thereby explained: $(798,-5\,378\,466\,956\,142)$
with $|m|\approx5.4\times10^{12}$ is the $T$-translate of $(798,-5586)$;
and $(-29317,-335\,124\,555\,576)$ with $|m|\approx3.4\times10^{11}$ was
produced by applying~\eqref{eq:map} to the sweep-found
$(-29317,-1\,373\,577\,672)$ the moment it was discovered. By contrast, the
solution pairs on $n=19$ and $n=-4$ are not translates, being independent in
the free part, consistent with $\operatorname{rk}E_{19}=3$ and
$\operatorname{rk}E_{-4}=2$.

\section{Mordell--Weil ranks}

Exact ranks by two-descent (\texttt{ellrank}, PARI/GP\,2.15.4), known
integral points supplied as hints:
\begin{align*}
\operatorname{rk}=1:\quad &
  n=1,15,114,131,-234,-2271,-9925,11527,11750,14709,15519;\\
\operatorname{rk}=2:\quad &
  n=-4,46,-54,-57,75,93,-4741,-6561,16531,17309,27949;\\
\operatorname{rk}=3:\quad &
  n=19,\text{ generators of }X\text{-coord }
  2394,\ \tfrac{7703436}{1369},\ \tfrac{2123383}{2601}.
\end{align*}
$E_{-29}$ has $\operatorname{rk}\in[1,3]$ (possible nontrivial $2$-Sha).
Seven rank-$2$ fibers ($n=93,-4741,-6561,16531,17309,27949$, conditionally
$-29$) possess a provably existing second generator not yet found; each is a
target for $4$-descent and a potential source of further large solutions via
the group law.

\begin{remark}[Empirical patterns in the solution set]
\leavevmode
\begin{enumerate}
\item \textbf{100 signed solutions.} The table now contains exactly $100$
  signed integer solutions $(n,m,y)$, the $50$th triple having been found at
  $|m|\approx2.0\times10^{9}$.
\item \textbf{No rank-$0$ fiber.} Every solution-bearing fiber tested has
  rank $\ge1$; eleven of twenty-two have rank $\ge2$.
\item \textbf{Large-$|n|$ bias.} Among distinct fibers first discovered at
  $|m|>10^{8}$, nine of twelve have $|n|>9000$, a pronounced bias invisible
  to fixed-$n$ searches. Yet $n=-970$, $-234$ show small-$|n|$ fibers
  continue producing at larger $|m|$.
\item \textbf{Solution spacing.} Gaps between consecutive solutions (in
  $|m|$) range from $\sim10^{6}$ to $\sim3.6\times10^{8}$, broadly
  consistent with a Poisson spacing model at density $\sim1$ per
  $\sim1.5\times10^{8}$ in $|m|$.
\item \textbf{Range of $n$.} Grew from $[-1641,\,5118]$ to
  $[-29317,\,27949]$.
\end{enumerate}
\end{remark}

\section{Software and reproducibility}

All results are reproducible with the following programs (available in the
accompanying repository):
\begin{itemize}
\item \texttt{divisor\_sweep.c}: exhaustive sweep in $m$, $n$ unbounded.
  Compile: \texttt{gcc -O3 -march=native -o divisor\_sweep divisor\_sweep.c -lm}.
  Usage: \texttt{./divisor\_sweep lo hi M outfile}.
  Cost: $\sum_{|m|\le M}\tau(2m^{3})$ divisor pairs at $\sim20$\,ns each
  ($\approx5$ core-hours for $M=10^{9}$; trivially parallel over $m$-ranges).
\item \texttt{small\_cofactor\_sweep.c}: stratified sweep for the
  Proposition. Usage: \texttt{./strat d\_lo d\_hi M outfile}.
\item \texttt{run\_sweep.sh}: parallel driver.
  Usage: \texttt{./run\_sweep.sh lo hi ncores}.
\item \texttt{verify\_solutions.py}: exact Python verification of all $50$
  rows and any new hits. Usage: \texttt{python3 verify\_solutions.py < hits.txt}.
\end{itemize}

\noindent\textbf{Extending the results.}
\begin{itemize}
\item Theorem~\ref{thm:complete} to $M=10^{10}$: $\sim50$ core-hours.
\item Corollary~\ref{cor:posm} to $|n|\le10^{4}$: sweep to $M=2.4\times10^{9}$
  ($\sim15$ core-hours from the current frontier).
\item Corollary~\ref{cor:posm} to $|n|\le10^{5}$: sweep to
  $M=2.4\times10^{11}$ ($\sim1000$ core-hours; suitable for a cluster).
\item Negative-$m$ classification per fiber: Magma's
  \texttt{IntegralPoints(E\_n)} loop over $|n|\le N$, using the rank table
  above as input ($\sim50$ core-hours for $|n|\le10^{5}$).
\end{itemize}

